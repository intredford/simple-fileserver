{
	"name": "fileserver",
	"version": "1.0.0",
	"description": "Simple fileserver for personal use",
	"main": "index.js",
	"type": "module",
	"scripts": {
		"dev": "nodemon index.js"
	},
	"nodemonConfig": {
		"ignore": [
			"database/",
			"public/uploads"
		]
	},
	"keywords": [
		"fileserver"
	],
	"author": "dima",
	"license": "MIT",
	"dependencies": {
		"@databases/sqlite": "^4.0.2",
		"cors": "^2.8.5",
		"dotenv": "^16.3.1",
		"express": "^4.18.2",
		"express-fileupload": "^1.5.2",
		"node-cron": "^3.0.3",
		"nodemon": "^3.0.1",
		"qrcode": "^1.5.3"
	},
	"imports": {
		"#lib/*": "./lib/*.js",
		"#utils/*": "./utils/*.js",
